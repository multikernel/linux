# Multikernel configuration
#

config ARCH_SUPPORTS_MULTIKERNEL
	bool

# The arch parks pool CPUs in a host-owned area inside pool memory
config ARCH_HAS_MK_HOST_PARK
	bool

# The arch routes the MSIs of an instance's devices on the instance's behalf
config ARCH_HAS_MK_MSI_PROXY
	bool

config MULTIKERNEL
	bool "Multikernel support"
	depends on ARCH_SUPPORTS_MULTIKERNEL
	depends on CONTIG_ALLOC
	depends on KEXEC_CORE
	depends on MEMORY_HOTPLUG
	depends on MEMORY_HOTREMOVE
	select LIBFDT
	select OF_DYNAMIC if OF
	help
	  Enable multikernel support, which allows running multiple kernel
	  instances simultaneously with resource isolation and inter-kernel
	  communication capabilities.

	  This feature provides:
	  - Sysfs interface for multikernel instance management
	  - Device tree based resource specification
	  - Memory pool management for kernel instances
	  - Integration with kexec for kernel loading
	  - A manifest handed to each spawn kernel on multikernel's own
	    boot channel, describing its resources and message rings

	  If unsure, say N.


# Confine the DMA of an instance's PCI devices to its memory. x86 runs
# them without an IOMMU so far.
config MULTIKERNEL_IOMMU
	def_bool MULTIKERNEL && IOMMU_API && PCI && ARM64
